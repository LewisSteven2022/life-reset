# Hosted Supabase (project clxotyxqmfvetqkdgzbe, eu-west-2)
# Local Docker alternative: http://127.0.0.1:54321 from `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=https://clxotyxqmfvetqkdgzbe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by integration tests to create fixture users. Never set on Vercel production.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only QA day fast-forward. Never set on Vercel production.
LIFE_RESET_QA_MODE=1

# Playwright E2E. Password only — never commit the filled .env.local.
# Leave PLAYWRIGHT_TEST_EMAIL unset. Hosted GoTrue rejects plus-addressing on
# example.com, so the suite uses playwright.reset.<timestamp>@example.com.
PLAYWRIGHT_TEST_PASSWORD=

# Auth dashboard settings for v1 (not env vars — record only):
# Project: https://supabase.com/dashboard/project/clxotyxqmfvetqkdgzbe
# Authentication → Sign In / Providers → Email: enabled
# Authentication → Sign In / Providers → Email → Confirm email: OFF
# Authentication → Sign In / Providers → Email → magic link: OFF (password on)
# SQL editor: run supabase/migrations/20260908072000_redeem_reward.sql once
# API keys: Project Settings → API Keys → publishable + secret/service_role
