# Hosted Supabase (project clxotyxqmfvetqkdgzbe, eu-west-2)
# Local Docker alternative: http://127.0.0.1:54321 from `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=https://clxotyxqmfvetqkdgzbe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by integration tests to create fixture users. Never set on Vercel production.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only QA day fast-forward. Never set on Vercel production.
LIFE_RESET_QA_MODE=1

# Playwright E2E. Password only — never commit the filled .env.local.
PLAYWRIGHT_TEST_PASSWORD=

# Auth dashboard settings for v1 (not env vars — record only):
# - Provider: Email + password (not magic link)
# - Confirm email: OFF
